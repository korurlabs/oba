{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "types": ["@oba/shared/i18n.d.ts"],
  "extends": "./base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true
  }
}
