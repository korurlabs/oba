{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  // Tests run under `bun test` (bun:test types), not tsc, and are never bundled.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
