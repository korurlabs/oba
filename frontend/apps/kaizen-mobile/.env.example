# Copy to .env.local for `expo start`. Every value is public: EXPO_PUBLIC_*
# values are inlined into the JavaScript bundle, so never put a secret here.
# On a physical device, replace localhost with the LAN IP of this machine.

# Oba API (projects/oba/backend, local profile).
EXPO_PUBLIC_OBA_API_URL=http://localhost:8080
# Keycloak realm sensey (local Keycloak of projects/oba/backend/docker-compose.yaml).
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8086/realms/sensey
# Public PKCE client of realm sensey for this app.
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=kaizen-mobile
# Account web app (onboarding, invitations, new organizations).
EXPO_PUBLIC_ACCOUNT_URL=http://localhost:3017
# Admin web app (managing organizations).
EXPO_PUBLIC_ADMIN_URL=http://localhost:3016
# Kaizen web app (board settings pages the app opens in the in-app browser).
EXPO_PUBLIC_KAIZEN_WEB_URL=http://localhost:3002
